# Copiar este archivo a .env.local dentro de apps/web.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Origen fijo de la web para enlaces de invitación y recuperación.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Demo visual con datos ficticios; se desactiva por defecto en producción.
ENABLE_DEMO=true

# Clave PÚBLICA de Cloudflare Turnstile. Activar también CAPTCHA en Supabase.
# La clave SECRETA se guarda únicamente en Supabase, nunca aquí.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Solo servidor. Nunca la pongas en una variable NEXT_PUBLIC_*.
# Necesaria para que Dirección cree usuarios (invitación por correo) y los desactive.
SUPABASE_SERVICE_ROLE_KEY=
